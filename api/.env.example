# Local dev: path to a service-account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=path/to/key.json

# Production (e.g. Render): paste the full service-account JSON as a single-line string.
# Checked first; if set, GOOGLE_APPLICATION_CREDENTIALS is ignored.
# GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key":"..."}

FRONTEND_URL=http://localhost:5173
